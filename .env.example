# Chave da API da Groq usada no enriquecimento do CNAE final.
GROQ_API_KEY=

# Modelo padrao de melhor custo-beneficio para a classificacao.
GROQ_MODEL=llama-3.1-8b-instant

# Chave da API do Gemini usada como fallback de extracao de PDFs.
GEMINI_API_KEY=

# Modelo padrao do Gemini para o fallback de extracao.
GEMINI_MODEL=gemini-2.5-flash
