# Chave da API do Gemini usada para a extração de dados e classificação de CNAEs.
GEMINI_API_KEY=

# Modelo padrão do Gemini a ser usado no projeto (padrão: gemini-2.5-flash).
# Outros modelos aceitos como fallback: gemini-2.5-pro e gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash

# Chave da API do Groq usada como fallback para a extração de dados.
GROQ_API_KEY=

# Modelo padrão do Groq a ser usado no projeto (padrão: llama-3.1-8b-instant para limites de cota maiores, ou llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.1-8b-instant

# Integração Tess AI (tess.im)
TESS_API_KEY=
TESS_AGENT_ID=

